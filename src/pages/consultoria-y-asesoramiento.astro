---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/layout/Header.astro";
import PageHero from "@/components/ui/PageHero.astro";
import IntroList from "@/components/ui/IntroList.astro";
import CorporateAdvisory from "@/components/sections/CorporateAdvisory.astro";
import PublicOfferings from "@/components/sections/PublicOfferings.astro";
import FinancingStructures from "@/components/sections/FinancingStructures.astro";
import Contact from "@/components/sections/Contact.astro";
import Footer from "@/components/layout/Footer.astro";

import heroImg from "@/assets/img/consultorias-hero.jpg";
---

<Layout
  title="Asesoría Corporativa y Estratégica | MMG Bank"
  description="Acompañamiento experto en las decisiones corporativas y estratégicas más relevantes para su empresa, con una visión integral de su crecimiento."
>
  <Header />

  <PageHero
    title="Asesoría Corporativa <br /> y Estratégica"
    image={heroImg}
    imageAlt="Equipo de asesores de MMG Bank en reunión estratégica"
    imagePosition="object-[80%_50%]"
  />

  <IntroList
    title="El respaldo que tu <br /> negocio necesita."
    paragraphs={[
      "MMG te acompaña en cada decisión estratégica, dándote el impulso y la asesoría que necesitas para llevar tu empresa al siguiente nivel.",
    ]}
    items={[
      "Asesoría Corporativa y Estratégica",
      "Soluciones de estructura de financiamiento",
      "Financiamiento con garantía de valores",
    ]}
  />

  <CorporateAdvisory />

  <PublicOfferings />

  <FinancingStructures />

  <Contact />

  <Footer />
</Layout>
