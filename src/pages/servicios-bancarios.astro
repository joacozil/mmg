---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/layout/Header.astro";
import PageHero from "@/components/ui/PageHero.astro";
import IntroList from "@/components/ui/IntroList.astro";
import CreditFacilities from "@/components/sections/CreditFacilities.astro";
import MastercardBenefits from "@/components/sections/MastercardBenefits.astro";
import Contact from "@/components/sections/Contact.astro";
import Footer from "@/components/layout/Footer.astro";

import heroImg from "@/assets/img/servicios-bancarios-hero.jpeg";
---

<Layout
  title="Servicios Bancarios | MMG Bank"
  description="Infraestructura bancaria premium con soluciones de pago multi-moneda diseñadas para facilitar el día a día de sus transacciones globales."
>
  <Header />

  <PageHero
    title="Servicios <br /> bancarios"
    image={heroImg}
    imageAlt="Dos ejecutivos conversando en un lounge con vista a la ciudad de Panamá"
    imagePosition="object-[70%_75%]"
  />

  <IntroList
    title="Soluciones para tu <br /> día a día."
    paragraphs={[
      "Complementamos nuestra asesoría financiera con servicios bancarios y soluciones de pago multi-moneda, diseñados para facilitar el día a día en tus transacciones globales.",
    ]}
    items={[
      "Depósito a plazo",
      "Cuentas Cash Plus",
      "Tarjetas de débito",
      "Tarjetas de crédito Mastercard Black",
      "Servicios escrow",
      "Custodia segura de activos físicos",
    ]}
    buttons={[
      { label: "Tarifas", href: "/pdf/tarifas.pdf", newTab: true },
      { label: "Comisiones", href: "/pdf/comisiones.pdf", newTab: true },
    ]}
  />

  <CreditFacilities />

  <MastercardBenefits />

  <Contact />

  <Footer />
</Layout>
