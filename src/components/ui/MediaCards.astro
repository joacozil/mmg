---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Card {
  title: string;
  text?: string; // supports inline HTML
  bullets?: string[]; // optional bullet list (supports inline HTML)
}

interface Props {
  title?: string; // optional small badge above the cards
  image?: ImageMetadata; // omit to render a placeholder block
  imageAlt?: string;
  imagePosition?: string; // object-position class, e.g. "object-[50%_30%]"
  cardBackground?: "white" | "cream"; // card surface color
  items: Card[];
  id?: string;
  class?: string;
}

const {
  title,
  image,
  imageAlt = "",
  imagePosition = "object-center",
  cardBackground = "white",
  items,
  id,
  class: className = "",
} = Astro.props;

const cardBgClass = cardBackground === "cream" ? "bg-cream" : "bg-white";
---

<div id={id} data-media-cards class={`w-full ${className}`}>
  <div class="container-custom">
    {
      title && (
        <p
          data-media-badge
          class="text-primary! uppercase font-bold mb-8 lg:mb-12"
        >
          {title}
        </p>
      )
    }

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:items-stretch">
      <!-- Image (or placeholder block when no image is provided) -->
      <div
        data-media-image
        class="lg:col-span-8 relative overflow-hidden min-h-75 lg:min-h-0"
      >
        {
          image ? (
            <Image
              src={image}
              alt={imageAlt}
              widths={[480, 768, 1024, 1400]}
              sizes="(min-width: 1024px) 58vw, 100vw"
              class={`absolute inset-0 h-full w-full object-cover ${imagePosition}`}
            />
          ) : (
            <div class="absolute inset-0 flex items-center justify-center bg-light-green">
              <span class="uppercase text-p-small text-darker-green/50">
                Imagen
              </span>
            </div>
          )
        }
      </div>

      <!-- Cards (styling consistent with Services.astro) -->
      <div class="lg:col-span-4 flex flex-col gap-6">
        {
          items.map((card) => (
            <div data-media-card class:list={["p-6 md:p-8", cardBgClass]}>
              <p class="text-darker-green uppercase font-bold text-p-large! mb-3">
                {card.title}
              </p>
              {card.text && <p class="text-p-small!" set:html={card.text} />}
              {card.bullets?.length && (
                <ul class="media-cards__bullets" role="list">
                  {card.bullets.map((bullet) => (
                    <li class="text-p-small!" set:html={bullet} />
                  ))}
                </ul>
              )}
            </div>
          ))
        }
      </div>
    </div>
  </div>
</div>

<style>
  /* Bullet list inside a card. */
  .media-cards__bullets {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .media-cards__bullets li {
    position: relative;
    padding-left: 1rem;
  }
  .media-cards__bullets li::before {
    content: "•";
    position: absolute;
    left: 0;
    top: 0;
  }
</style>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const prefersReduced = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  const blocks = document.querySelectorAll<HTMLElement>("[data-media-cards]");

  if (blocks.length && !prefersReduced) {
    blocks.forEach((block) => {
      const image = block.querySelector<HTMLElement>("[data-media-image]");
      const cards = block.querySelectorAll<HTMLElement>("[data-media-card]");

      if (image) gsap.set(image, { opacity: 0, y: 24 });
      if (cards.length) gsap.set(cards, { opacity: 0, x: 24 });

      const createTrigger = () => {
        ScrollTrigger.create({
          trigger: block,
          start: "top 75%",
          once: true,
          onEnter: () => {
            const tl = gsap.timeline();
            if (image)
              tl.to(
                image,
                { opacity: 1, y: 0, duration: 0.8, ease: "power3.out" },
                0,
              );
            if (cards.length)
              tl.to(
                cards,
                {
                  opacity: 1,
                  x: 0,
                  duration: 0.7,
                  stagger: 0.12,
                  ease: "power3.out",
                },
                0.1,
              );
          },
        });

        ScrollTrigger.refresh();
      };

      const init = () =>
        requestAnimationFrame(() => setTimeout(createTrigger, 100));

      if ((window as any).heroScrollTriggerInitialized) init();
      else
        window.addEventListener("hero-scroll-trigger-init", init, {
          once: true,
        });
    });
  }
</script>
