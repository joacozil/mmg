---
interface Props {
  title: string;
  text?: string; // omit to render the heading alone (full left column)
  badge?: string; // optional small label above the heading
  class?: string;
}

const { title, text, badge, class: className = "" } = Astro.props;
---

<div class={`grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 ${className}`}>
  <!-- Left Column: Title & Optional slot contents (like author metadata) -->
  <div class="lg:col-span-7 flex flex-col justify-start">
    {
      badge && (
        <p
          class="text-primary! uppercase font-bold mb-4"
          set:html={badge}
        />
      )
    }
    <h2 class="text-primary lg:max-w-[600px]" set:html={title} />
    <slot />
  </div>

  <!-- Right Column: Paragraph text (omitted when no text is provided) -->
  {
    text && (
      <div class="lg:col-span-5 flex items-start lg:justify-end w-full">
        <p class="lg:max-w-100 w-full" set:html={text} />
      </div>
    )
  }
</div>
