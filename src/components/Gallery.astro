---
// src/components/Gallery.astro
import { Image } from "astro:assets";
import imgAlianzas from "../assets/img/alianzas.jpg";
import imgCartas from "../assets/img/cartas.jpg";
import imgForo from "../assets/img/foro.jpg";
// Placeholder images for the additional slides (swap these out later)
import imgColleagues from "../assets/img/servicios-bancarios.jpg";
import imgTeamWork from "../assets/img/soluciones-de-inversion.jpg";
import imgChart from "../assets/img/report.jpg";
import imgContract from "../assets/img/asesoria-corporativa-y-estrategica.jpg";

const slides = [
  {
    img: imgAlianzas,
    alt: "Alianzas estratégicas MMG Bank",
    caption:
      "Alianzas estratégicas nos impulsan a lograr los Objetivos de Desarrollo Sostenible.",
  },
  {
    img: imgCartas,
    alt: "Cartas de crédito MMG Bank",
    caption:
      "Compromiso compartido a través de cartas y alianzas que generan valor a largo plazo.",
  },
  {
    img: imgForo,
    alt: "Foros y encuentros regionales MMG Bank",
    caption:
      "Foros y encuentros líderes que impulsan el diálogo y el intercambio de ideas en la región.",
  },
  // --- Placeholder slides ---
  {
    img: imgColleagues,
    alt: "Placeholder MMG Bank",
    caption:
      "Texto de ejemplo para una nueva iniciativa de sostenibilidad de MMG Bank.",
  },
  {
    img: imgTeamWork,
    alt: "Placeholder MMG Bank",
    caption:
      "Texto de ejemplo que describe el trabajo colaborativo de nuestros equipos.",
  },
  {
    img: imgChart,
    alt: "Placeholder MMG Bank",
    caption:
      "Texto de ejemplo sobre resultados y crecimiento financiero responsable.",
  },
  {
    img: imgContract,
    alt: "Placeholder MMG Bank",
    caption:
      "Texto de ejemplo sobre acuerdos que construyen relaciones de largo plazo.",
  },
];

const fallbackRotations = ["-rotate-2", "rotate-3", "-rotate-1"];
---

<section
  id="gallery-section"
  data-gallery-section
  class="w-full bg-cream pt-0 pb-section-gap relative overflow-hidden"
>
  <div class="container-custom">
    <!-- Fallback Layout: Beautiful grid for No-JS and Reduced Motion -->
    <div
      data-gallery-fallback-grid
      class="grid grid-cols-1 md:grid-cols-3 gap-8 items-start w-full"
    >
      {
        slides.map((slide, i) => (
          <div class="flex flex-col items-center text-center gap-4">
            <div
              class:list={[
                "w-full aspect-4/3 shadow-md rounded-sm overflow-hidden",
                fallbackRotations[i % fallbackRotations.length],
              ]}
            >
              <Image
                src={slide.img}
                alt={slide.alt}
                class="w-full h-full object-cover"
              />
            </div>
            <h4 class="text-p-small! font-bold mt-2 max-w-[300px]">
              {slide.caption}
            </h4>
          </div>
        ))
      }
    </div>

    <!-- Enhanced Layout: Pinned Stack Animation Container (enabled dynamically via JS) -->
    <!-- Vertical stack: photos on top, captions below -->
    <div
      data-gallery-stack-container
      class="hidden relative w-full flex-col items-center justify-center gap-10 lg:gap-12"
    >
      <!-- Photo stack container -->
      <div
        class="gallery-cards-container relative w-full aspect-4/3 z-10 shrink-0 max-w-[520px] sm:max-w-[640px]"
      >
        {
          slides.map((slide, i) => (
            <div
              data-gallery-card={i}
              class="gallery-card absolute inset-0 shadow-lg rounded-sm overflow-hidden"
            >
              <Image
                src={slide.img}
                alt={slide.alt}
                class="w-full h-full object-cover"
              />
            </div>
          ))
        }
      </div>

      <!-- Captions Container -->
      <div
        class="gallery-captions-wrapper w-full max-w-[640px] text-center relative min-h-[120px] sm:min-h-[100px] flex items-center justify-center"
      >
        {
          slides.map((slide, i) => (
            <h4
              data-gallery-caption={i}
              class:list={[
                "gallery-caption max-w-[600px] text-center text-darker-green! mx-auto text-p-large! font-bold absolute left-0 right-0",
                i === 0 ? "opacity-100" : "opacity-0 pointer-events-none",
              ]}
            >
              {slide.caption}
            </h4>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  /* Dynamic layout switching */
  :global(.gallery-animated-active) {
    /* Approx. height of the fixed header — tune here to nudge vertical balance. */
    --gallery-header-offset: 4.5rem;
    height: 100vh !important;
    display: block !important;
    padding: 0 !important;
  }

  /* Center the content within the viewport area BELOW the fixed header.
     The inner container is sized to (100vh - header) and pushed down by the
     header height, so flex-centering inside it lands the stack in the true
     visible center — no border-box padding math to fight. */
  :global(.gallery-animated-active) .container-custom {
    height: calc(100vh - var(--gallery-header-offset));
    margin-top: var(--gallery-header-offset);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }

  :global(.gallery-animated-active) [data-gallery-fallback-grid] {
    display: none !important;
  }

  :global(.gallery-animated-active) [data-gallery-stack-container] {
    display: flex !important;
  }

  /* Styling details to make the stack look premium */
  .gallery-card {
    will-change: transform, opacity;
    backface-visibility: hidden;
    transform-origin: center center;
  }

  .gallery-caption {
    will-change: transform, opacity;
  }
</style>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const prefersReduced = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;
  const section = document.querySelector<HTMLElement>("[data-gallery-section]");

  // Only run animations if motion is allowed and DOM elements exist
  if (section && !prefersReduced) {
    const fallbackGrid = section.querySelector<HTMLElement>(
      "[data-gallery-fallback-grid]",
    );
    const stackContainer = section.querySelector<HTMLElement>(
      "[data-gallery-stack-container]",
    );

    const cards = Array.from(
      section.querySelectorAll<HTMLElement>("[data-gallery-card]"),
    );
    const captions = Array.from(
      section.querySelectorAll<HTMLElement>("[data-gallery-caption]"),
    );
    const count = cards.length;

    if (
      fallbackGrid &&
      stackContainer &&
      count > 0 &&
      captions.length === count
    ) {
      // 1. Activate animated layout
      section.classList.add("gallery-animated-active");

      // Appearance of a card sitting at a given depth in the stack
      // (depth 0 = top/active card, deeper cards recede slightly).
      const stackStyle = (depth: number) => ({
        rotate: depth === 0 ? -5 : depth % 2 ? 4 : -2,
        scale: Math.max(0.8, 1 - depth * 0.04),
        y: depth * 8,
        x: depth === 0 ? 0 : depth % 2 ? 8 : -8,
        opacity: 1,
        zIndex: 30 - depth,
      });

      // Appearance of a card that has already been scrolled past.
      // It stays ABOVE the stack (high zIndex) while it drifts up and fades,
      // so it visibly peels away to reveal the next image underneath instead
      // of being instantly covered by it.
      const passedStyle = (i: number) => ({
        y: "-55%",
        rotate: i % 2 ? 8 : -8,
        scale: 0.9,
        opacity: 0,
        zIndex: 50,
      });

      // 2. Setup initial states to prevent layout shifts
      cards.forEach((card, i) => gsap.set(card, stackStyle(i)));
      captions.forEach((cap, i) =>
        gsap.set(cap, { opacity: i === 0 ? 1 : 0, y: i === 0 ? 0 : 15 }),
      );

      let currentStateIndex = -1;

      const goToState = (index: number, immediate = false) => {
        if (index === currentStateIndex) return;
        currentStateIndex = index;

        const duration = immediate ? 0 : 1.1;
        const ease = immediate ? "none" : "power2.inOut";

        // Kill active animations first to prevent overlap conflicts
        gsap.killTweensOf([...cards, ...captions]);

        const t = gsap.timeline({ defaults: { ease, duration } });

        cards.forEach((card, i) => {
          const delta = i - index;
          t.to(card, delta < 0 ? passedStyle(i) : stackStyle(delta), 0);
        });

        captions.forEach((cap, i) => {
          t.to(
            cap,
            {
              opacity: i === index ? 1 : 0,
              y: i === index ? 0 : i < index ? -15 : 15,
            },
            0,
          );
        });
      };

      const indexForProgress = (p: number) =>
        Math.min(count - 1, Math.max(0, Math.round(p * (count - 1))));

      // 3. Build scroll trigger
      const createTriggers = () => {
        const trigger = ScrollTrigger.create({
          trigger: section,
          start: "top top",
          end: `+=${(count - 1) * 100}%`,
          pin: true,
          anticipatePin: 1,
          snap: {
            snapTo: Array.from({ length: count }, (_, i) => i / (count - 1)),
            duration: { min: 0.4, max: 0.8 },
            delay: 0.08,
            ease: "power2.inOut",
          },
          onUpdate: (self) => goToState(indexForProgress(self.progress)),
        });

        // Set initial state based on starting scroll position
        goToState(indexForProgress(trigger.progress), true);

        ScrollTrigger.refresh();
      };

      const initTriggers = () => {
        // Defer trigger creation to avoid React hydration shifts
        requestAnimationFrame(() => {
          setTimeout(createTriggers, 100);
        });
      };

      // Sync trigger initiation with Hero components
      if ((window as any).heroScrollTriggerInitialized) {
        initTriggers();
      } else {
        window.addEventListener("hero-scroll-trigger-init", initTriggers, {
          once: true,
        });
      }
    }
  }
</script>
