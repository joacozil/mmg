---
import LinkMore from "./LinkMore.astro";

interface BannerItem {
  icon?: string; // raw SVG markup; falls back to an arrow
  title: string;
  text: string; // supports inline HTML
  bullets?: string[]; // optional bullet list below the text
  buttonLabel?: string; // omit to render the item without a button
  buttonHref?: string;
}

interface Props {
  items: BannerItem[];
  id?: string;
  class?: string;
}

const { items, id, class: className = "" } = Astro.props;
---

<div id={id} data-banner class={`w-full ${className}`}>
  <div class="container-custom">
    <div class="bg-primary p-8 lg:p-12">
      <div class="banner-grid">
        {
          items.map((item) => (
            <div data-banner-item class="banner-grid__item">
              <div class="flex items-center gap-4 mb-3">
                {item.icon ? (
                  <span
                    class="banner-grid__icon"
                    set:html={item.icon}
                    aria-hidden="true"
                  />
                ) : (
                  <svg
                    class="banner-grid__arrow text-white"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    aria-hidden="true"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"
                    />
                  </svg>
                )}
                <p class="text-white! font-bold uppercase" set:html={item.title} />
              </div>
              <p
                class:list={[
                  "text-p-small! text-white!",
                  (item.bullets?.length || item.buttonLabel) && "mb-6",
                ]}
                set:html={item.text}
              />
              {item.bullets?.length && (
                <ul
                  class:list={["banner-grid__bullets", item.buttonLabel && "mb-6"]}
                  role="list"
                >
                  {item.bullets.map((bullet) => (
                    <li class="text-p-small! text-white!" set:html={bullet} />
                  ))}
                </ul>
              )}
              {item.buttonLabel && (
                <LinkMore
                  href={item.buttonHref ?? "#"}
                  color="white"
                  class="mt-auto self-start"
                >
                  {item.buttonLabel}
                </LinkMore>
              )}
            </div>
          ))
        }
      </div>
    </div>
  </div>
</div>

<style>
  .banner-grid {
    display: grid;
    grid-template-columns: 1fr;
    column-gap: 0;
    row-gap: 2.5rem;
  }

  .banner-grid__item {
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .banner-grid__icon {
    display: inline-block;
    width: 3rem;
    height: 3rem;
    flex-shrink: 0;
  }
  .banner-grid__icon :global(svg) {
    width: 100%;
    height: 100%;
    display: block;
    /* Some icons draw to the viewBox edge; keep them from being clipped. */
    overflow: visible;
  }

  /* Arrow fallback when an item has no icon. */
  .banner-grid__arrow {
    width: 1.75rem;
    height: 1.75rem;
    flex-shrink: 0;
  }

  /* Bullet list under the paragraph copy. */
  .banner-grid__bullets {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .banner-grid__bullets li {
    position: relative;
    padding-left: 1rem;
  }
  .banner-grid__bullets li::before {
    content: "•";
    position: absolute;
    left: 0;
    top: 0;
  }

  /* Equal-width columns: equal padding on EVERY column (outer sides included),
     dividers at the true 1/3 & 2/3 track edges via border-left. This keeps both
     the cells (divider-to-divider) and the text blocks identical. */

  /* Tablet: 2 columns */
  @media (min-width: 640px) and (max-width: 1023.98px) {
    .banner-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .banner-grid__item {
      padding: 0 1.5rem;
    }
  }

  /* Desktop: 3 columns */
  @media (min-width: 1024px) {
    .banner-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .banner-grid__item {
      padding: 0 2.5rem;
    }
  }
</style>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const prefersReduced = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  const blocks = document.querySelectorAll<HTMLElement>("[data-banner]");

  if (blocks.length && !prefersReduced) {
    blocks.forEach((block) => {
      const items = block.querySelectorAll<HTMLElement>("[data-banner-item]");
      if (items.length) gsap.set(items, { opacity: 0, y: 24 });

      const createTrigger = () => {
        ScrollTrigger.create({
          trigger: block,
          start: "top 80%",
          once: true,
          onEnter: () => {
            if (items.length)
              gsap.to(items, {
                opacity: 1,
                y: 0,
                duration: 0.7,
                stagger: 0.12,
                ease: "power3.out",
              });
          },
        });

        ScrollTrigger.refresh();
      };

      const init = () =>
        requestAnimationFrame(() => setTimeout(createTrigger, 100));

      if ((window as any).heroScrollTriggerInitialized) init();
      else
        window.addEventListener("hero-scroll-trigger-init", init, {
          once: true,
        });
    });
  }
</script>
