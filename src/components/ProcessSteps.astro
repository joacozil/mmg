---
interface Step {
  title: string;
  text: string; // supports inline HTML
}

interface Props {
  items: Step[];
  id?: string;
  class?: string;
}

const { items, id, class: className = "" } = Astro.props;
---

<div
  id={id}
  data-process
  class={`w-full bg-light-green p-8 lg:p-12 ${className}`}
>
  <div class="process-grid">
    {
      items.map((item) => (
        <div data-process-item class="process-grid__item">
          <div class="flex items-center gap-3 mb-3">
            <span class="process-grid__square" aria-hidden="true" />
            <p class="text-p-small! font-bold uppercase text-darker-green">
              {item.title}
            </p>
          </div>
          <p class="text-p-small! text-darker-green text-balance" set:html={item.text} />
        </div>
      ))
    }
  </div>
</div>

<style>
  .process-grid {
    display: grid;
    grid-template-columns: 1fr;
    column-gap: 0;
    row-gap: 2.5rem;
  }

  .process-grid__item {
    position: relative;
  }

  .process-grid__square {
    width: 0.9rem;
    height: 0.9rem;
    background-color: var(--color-primary);
    flex-shrink: 0;
  }

  /* Equal-width columns: each track is minmax(0, 1fr) so all columns are
     identical, and the spacing between them comes from column-gap — NOT inner
     padding. With no per-item padding the content adapts to its track width
     and the outer edges stay flush with the band. */

  /* Desktop: 3 columns (tablet & mobile stay single-column) */
  @media (min-width: 1024px) {
    .process-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: 4rem;
    }
  }
</style>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const prefersReduced = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  const blocks = document.querySelectorAll<HTMLElement>("[data-process]");

  if (blocks.length && !prefersReduced) {
    blocks.forEach((block) => {
      const items = block.querySelectorAll<HTMLElement>("[data-process-item]");
      if (items.length) gsap.set(items, { opacity: 0, y: 24 });

      const createTrigger = () => {
        ScrollTrigger.create({
          trigger: block,
          start: "top 80%",
          once: true,
          onEnter: () => {
            if (items.length)
              gsap.to(items, {
                opacity: 1,
                y: 0,
                duration: 0.7,
                stagger: 0.1,
                ease: "power3.out",
              });
          },
        });

        ScrollTrigger.refresh();
      };

      const init = () =>
        requestAnimationFrame(() => setTimeout(createTrigger, 100));

      if ((window as any).heroScrollTriggerInitialized) init();
      else
        window.addEventListener("hero-scroll-trigger-init", init, {
          once: true,
        });
    });
  }
</script>
