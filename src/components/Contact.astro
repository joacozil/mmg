---
// src/components/Contact.astro
---

<section
  id="contact-section"
  data-contact-section
  class="w-full bg-cream pt-0 pb-section-gap relative overflow-x-clip"
>
  <div class="container-custom">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 items-start">
      <!-- Left Column: Title / Tagline -->
      <div data-contact-left class="lg:col-span-6 flex flex-col justify-start">
        <h2 class="text-primary">
          Hable con nuestros expertos y resuelva sus necesidades financieras
          eficientemente
        </h2>
      </div>

      <!-- Right Column: Contact Form -->
      <form class="lg:col-span-6 flex flex-col gap-6 w-full" id="contact-form">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-stretch">
          <!-- Left Form Fields Column -->
          <div class="flex flex-col gap-5">
            <div data-form-field class="flex flex-col">
              <input
                type="text"
                id="nombre"
                name="nombre"
                placeholder="Nombre"
                aria-label="Nombre"
                class="w-full bg-white px-4 py-3 text-p text-black border-0 border-b-2 border-transparent focus:outline-none focus:border-primary transition-all"
                required
              />
            </div>

            <div data-form-field class="flex flex-col">
              <input
                type="text"
                id="empresa"
                name="empresa"
                placeholder="Empresa"
                aria-label="Empresa"
                class="w-full bg-white px-4 py-3 text-p text-black border-0 border-b-2 border-transparent focus:outline-none focus:border-primary transition-all"
                required
              />
            </div>

            <div data-form-field class="flex flex-col">
              <input
                type="tel"
                id="telefono"
                name="telefono"
                placeholder="Teléfono"
                aria-label="Teléfono"
                class="w-full bg-white px-4 py-3 text-p text-black border-0 border-b-2 border-transparent focus:outline-none focus:border-primary transition-all"
              />
            </div>

            <div data-form-field class="flex flex-col">
              <input
                type="email"
                id="email"
                name="email"
                placeholder="Email"
                aria-label="Email"
                class="w-full bg-white px-4 py-3 text-p text-black border-0 border-b-2 border-transparent focus:outline-none focus:border-primary transition-all"
                required
              />
            </div>

            <div data-form-field class="flex flex-col">
              <div class="relative w-full">
                <select
                  id="tipo_consulta"
                  name="tipo_consulta"
                  aria-label="Tipo de consulta"
                  class="w-full bg-white px-4 py-3 pr-10 text-p text-black border-0 border-b-2 border-transparent focus:outline-none focus:border-primary transition-all appearance-none cursor-pointer"
                  required
                >
                  <option value="" disabled selected
                    >Tipo de consulta</option
                  >
                  <option value="Banca Privada">Banca Privada</option>
                  <option value="Asset Management">Asset Management</option>
                  <option value="Banca Corporativa">Banca Corporativa</option>
                  <option value="Otros">Otros</option>
                </select>
                <div
                  class="absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none flex items-center"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="2.5"
                    stroke="currentColor"
                    class="w-4 h-4"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="m19.5 8.25-7.5 7.5-7.5-7.5"></path>
                  </svg>
                </div>
              </div>
            </div>
          </div>

          <!-- Right Form Fields Column -->
          <div class="flex flex-col gap-5 h-full">
            <div data-form-field class="flex flex-col">
              <input
                type="text"
                id="cargo"
                name="cargo"
                placeholder="Cargo de la empresa"
                aria-label="Cargo de la empresa"
                class="w-full bg-white px-4 py-3 text-p text-black border-0 border-b-2 border-transparent focus:outline-none focus:border-primary transition-all"
              />
            </div>

            <div data-form-field class="flex flex-col">
              <div class="relative w-full">
                <select
                  id="nuevo_cliente"
                  name="nuevo_cliente"
                  aria-label="¿Es usted nuevo cliente?"
                  class="w-full bg-white px-4 py-3 pr-10 text-p text-black border-0 border-b-2 border-transparent focus:outline-none focus:border-primary transition-all appearance-none cursor-pointer"
                  required
                >
                  <option value="" disabled selected
                    >¿Es usted nuevo cliente?</option
                  >
                  <option value="Si">Sí</option>
                  <option value="No">No</option>
                </select>
                <div
                  class="absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none flex items-center"
                >
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="2.5"
                    stroke="currentColor"
                    class="w-4 h-4"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="m19.5 8.25-7.5 7.5-7.5-7.5"></path>
                  </svg>
                </div>
              </div>
            </div>

            <div
              data-form-field
              class="flex flex-col flex-1 min-h-[200px] lg:min-h-0"
            >
              <textarea
                id="mensaje"
                name="mensaje"
                placeholder="Mensaje"
                aria-label="Mensaje"
                class="w-full bg-white px-4 py-3 text-p text-black border-0 border-b-2 border-transparent focus:outline-none focus:border-primary transition-all flex-1 resize-none min-h-[120px] lg:min-h-[140px]"
                required></textarea>
            </div>
          </div>
        </div>

        <!-- Submit button -->
        <div data-form-submit class="flex justify-start mt-2">
          <button
            type="submit"
            class="btn-more inline-flex items-center gap-1 uppercase transition-colors duration-200 text-primary bg-transparent border-none p-0 cursor-pointer focus:outline-none"
          >
            Enviar
          </button>
        </div>
      </form>
    </div>
  </div>
</section>

<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const prefersReduced = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  // Simple form submission handler for feedback/mocking
  const form = document.getElementById(
    "contact-form",
  ) as HTMLFormElement | null;
  if (form) {
    form.addEventListener("submit", (e) => {
      e.preventDefault();
      alert("¡Gracias! Su mensaje ha sido enviado exitosamente.");
      form.reset();
    });
  }

  // Setup animations if not prefersReduced (only tagline column, not form)
  const section = document.querySelector<HTMLElement>("[data-contact-section]");
  if (section && !prefersReduced) {
    const leftCol = section.querySelector<HTMLElement>("[data-contact-left]");

    // Set initial hidden states immediately to avoid visual jump (FOUC)
    if (leftCol) {
      gsap.set(leftCol, { opacity: 0, x: -40 });
    }

    const createTriggers = () => {
      ScrollTrigger.create({
        trigger: section,
        start: "top 60%", // trigger at top 60% of viewport
        once: true,
        onEnter: () => {
          // Left title column reveal
          if (leftCol) {
            gsap.to(leftCol, {
              opacity: 1,
              x: 0,
              duration: 0.9,
              ease: "power3.out",
            });
          }
        },
      });

      ScrollTrigger.refresh();
    };

    const initTriggers = () => {
      // Defer to allow React hydration/rendering and pin spacing layout to settle completely
      requestAnimationFrame(() => {
        setTimeout(createTriggers, 100);
      });
    };

    // Initialize triggers after Hero is ready
    if ((window as any).heroScrollTriggerInitialized) {
      initTriggers();
    } else {
      window.addEventListener("hero-scroll-trigger-init", initTriggers, {
        once: true,
      });
    }
  }
</script>

<style>
  .btn-more {
    position: relative;
    padding-bottom: 6px;
    font-size: var(--fs-p-large);
    font-weight: 600;
    line-height: var(--lh-btn);
    letter-spacing: var(--ls-btn);
  }

  .btn-more::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 2px;
    background-color: currentColor;
    transform: scaleX(0);
    transform-origin: right center;
    /* Delay on leave keeps the collapse from feeling abrupt on fast passes */
    transition: transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94) 0.25s;
  }

  .btn-more:hover::after {
    transform: scaleX(1);
    transform-origin: left center;
    /* Delay on enter so quick fly-overs never trigger the underline */
    transition: transform 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94) 0.2s;
  }

  @media (prefers-reduced-motion: reduce) {
    .btn-more::after {
      transition: none;
    }
  }

  /* Muted placeholder hint (solid color, no opacity) */
  #contact-form input::placeholder,
  #contact-form textarea::placeholder {
    color: #6b6b6b;
    opacity: 1;
  }

  /* Match select placeholder until a real option is chosen */
  #contact-form select:invalid {
    color: #6b6b6b;
  }
</style>
