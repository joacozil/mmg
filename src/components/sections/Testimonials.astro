---
import Section from "@/components/ui/Section.astro";
const testimonials = [
  {
    quote: `"Pensé que comprar mi primer apartamento en la ciudad sería un dolor de cabeza, pero <strong>el equipo de MMG me guió en cada paso del camino.</strong> El trato fue súper cercano y la aprobación fue mucho más rápida de lo que esperaba. Hoy ya tengo las llaves de mi hogar."`,
    role: "Cliente de préstamo hipotecario",
    name: "Carlos Mendoza",
  },
  {
    quote: `"Para mí, el tiempo es oro. Con la banca en línea y la app del banco resuelvo todo desde mi celular: transferencias ACH express, pago de servicios y recargas, sin tener que pisar una sucursal. <strong>Es la banca digital que un profesional moderno necesita.</strong>"`,
    role: "Diseñadora freelance y usuaria digital",
    name: "Valerie Chen",
  },
  {
    quote: `"La plataforma de MMG me permite gestionar mis inversiones internacionales con total transparencia y rapidez. <strong>Es un aliado clave para la expansión de mi negocio en la región.</strong>"`,
    role: "Inversionista y cliente corporativo",
    name: "Mariana Silva",
  },
  {
    quote: `"Para mí, el tiempo es oro. Con la banca en línea y la app del banco resuelvo todo desde mi celular: transferencias ACH express, pago de servicios y recargas, sin tener que pisar una sucursal. <strong>Es la banca digital que un profesional moderno necesita.</strong>"`,
    role: "Diseñadora freelance y usuaria digital",
    name: "Valerie Chen",
  },
  {
    quote: `"La plataforma de MMG me permite gestionar mis inversiones internacionales con total transparencia y rapidez. <strong>Es un aliado clave para la expansión de mi negocio en la región.</strong>"`,
    role: "Inversionista y cliente corporativo",
    name: "Mariana Silva",
  },
];
---

<Section spacing="open" data-testimonials-section>
  <div class="container-custom">
    <!-- Swiper container -->
    <div data-testimonials-swiper class="swiper testimonials-swiper overflow-visible!">
      <div class="swiper-wrapper">
        {
          testimonials.map((t) => (
            <div class="swiper-slide h-auto">
              <div class="bg-light-green text-black p-8 md:p-12 flex flex-col justify-between h-full min-h-[300px]">
                <p class="[&>strong]:font-bold " set:html={t.quote} />

                <div class="flex items-center gap-4 justify-end mt-8 self-end">
                  <div class="text-right">
                    <span class="block text-p-small! uppercase">{t.role}</span>
                    <span class="block font-bold text-p-large! mt-1">
                      {t.name}
                    </span>
                  </div>
                  <div class="w-[5px] h-full bg-primary shrink-0" />
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <!-- Line-style pagination indicators -->
    <div data-testimonials-pagination class="testimonials-pagination"></div>
  </div>
</Section>

<style>
  /* Fix swiper slides height alignment */
  .swiper-slide {
    display: flex;
    height: auto;
  }

  /* Line-style pagination (matches the Team slider): the active line grows
     and turns brand green; inactive lines stay short and muted. */
  .testimonials-pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 8px;
    margin-top: 3rem;
    position: relative;
    z-index: 10;
  }
  :global(.testimonials-pagination .swiper-pagination-bullet) {
    width: 24px;
    height: 3px;
    background-color: rgba(18, 71, 52, 0.25) !important;
    border-radius: 0 !important;
    margin: 0 !important;
    transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    opacity: 1 !important;
    cursor: pointer;
  }
  :global(.testimonials-pagination .swiper-pagination-bullet-active) {
    width: 48px;
    background-color: var(--color-primary) !important;
  }
</style>

<script>
  import Swiper from "swiper";
  import { Autoplay, Pagination } from "swiper/modules";
  import "swiper/css";
  import "swiper/css/autoplay";
  import "swiper/css/pagination";

  // Initialize Swiper on component load
  const swiperEl = document.querySelector<HTMLElement>(".testimonials-swiper");
  let swiper: Swiper | null = null;

  if (swiperEl) {
    swiper = new Swiper(".testimonials-swiper", {
      modules: [Autoplay, Pagination],
      loop: false, // Not infinite loop
      autoplay: {
        delay: 5000,
        disableOnInteraction: false,
      },
      pagination: {
        el: ".testimonials-pagination",
        clickable: true,
      },
      slidesPerView: 1,
      spaceBetween: 24,
      breakpoints: {
        768: {
          slidesPerView: 2,
        },
      },
    });

    // Pause autoplay initially
    swiper.autoplay.stop();

    // Use Intersection Observer to play only when visible
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          swiper?.autoplay.start();
        } else {
          swiper?.autoplay.stop();
        }
      });
    }, { threshold: 0.1 });

    observer.observe(swiperEl);
  }
</script>
