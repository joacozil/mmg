---
// src/components/Gallery.astro
import { getImage } from "astro:assets";
import GallerySection from "./GallerySection.tsx";

import imgHito1 from "@/assets/img/hito-1.jpeg";
import imgHito2 from "@/assets/img/hito-2.jpeg";
import imgHito3 from "@/assets/img/hito-3.jpeg";
import imgAccion from "@/assets/img/chart.jpg";
// Placeholder images for the remaining achievements (swap these out later)
import imgColleagues from "@/assets/img/servicios-bancarios.jpg";
import imgBonoVerde from "@/assets/img/TorreMorganMorgan.jpeg";
import imgChart from "@/assets/img/report.jpg";
import imgContract from "@/assets/img/asesoria-corporativa-y-estrategica.jpg";
import imgForo from "@/assets/img/foro.jpg";

// Raw milestone data; images are optimized to WebP below before being passed
// to the React island (which renders plain <img>).
const milestones = [
  {
    img: imgHito1,
    alt: "Creadores de Mercado de la deuda soberana doméstica de Panamá",
    year: "2006",
    description:
      "Participa en programa Creadores de Mercado de la deuda soberana doméstica de Panamá.",
  },
  {
    img: imgHito2,
    alt: "Participación activa en la Bolsa de Valores de Panamá",
    year: "2006",
    description:
      "Inicia participación activa en la Bolsa de Valores de Panamá (BVP).",
  },
  {
    img: imgHito3,
    alt: "Creadores de Mercado de la Deuda soberana doméstica Panamá",
    year: "2011",
    description:
      "Participante del programa de Creadores de Mercado de la Deuda soberana doméstica Panamá.",
  },
  {
    img: imgAccion,
    alt: "Primer creador privado para una acción corporativa",
    year: "2016",
    description: "Primer creador privado para una acción corporativa.",
  },
  // --- Remaining achievements: placeholder images ---
  {
    img: imgChart,
    alt: "Emisiones públicas de MMG Bank",
    year: "2016",
    description:
      "+50 emisiones públicas de 35 emisores distintos, más de 4,000 millones de dólares recaudados.",
  },
  {
    img: imgColleagues,
    alt: "Integración de los mercados regionales",
    year: "2016",
    description:
      "Pioneros en la integración de los mercados regionales mediante el programa Operador Remoto entre la Bolsa de Valores Latinoamericana de Valores y la Bolsa de Valores de El Salvador.",
  },
  {
    img: imgBonoVerde,
    alt: "Primer Bono Verde en Centroamérica",
    year: "2019",
    description:
      "Estructuración y colocación del primer Bono Verde en Centroamérica.",
  },
  {
    img: imgContract,
    alt: "Primer Bono Sostenible para una institución financiera regional",
    year: "2020",
    description:
      "Estructuración y colocación del primer Bono Sostenible para una institución financiera regional.",
  },
  {
    img: imgForo,
    alt: "Primera transacción fronteriza entre Panamá y Guatemala",
    year: "2021",
    description:
      "Ejecución de la primera transacción fronteriza entre Panamá y Guatemala.",
  },
];

const achievements = await Promise.all(
  milestones.map(async ({ img, ...rest }) => ({
    src: (await getImage({ src: img, format: "webp", width: 1200 })).src,
    ...rest,
  })),
);
---

<GallerySection
  client:load
  title="Los momentos que forjan nuestra identidad. Una mirada a nuestra historia, nuestros logros y el compromiso que define nuestro rumbo."
  achievements={achievements}
  initialCount={4}
/>
