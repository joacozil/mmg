---
import Section from "@/components/ui/Section.astro";
import SplitRow from "@/components/ui/SplitRow.astro";
import MarketStack from "@/components/ui/MarketStack.astro";
---

<Section spacing="tight" id="mercados">
  <div class="container-custom">
    <SplitRow
      badge="Negociación, mercados y cuentas de custodia"
      title='Desde Panamá hacia las principales bolsas del mundo: <span class="text-black text-h2!">a través de nuestra plataforma digital, conectamos su capital con oportunidades globales sin fronteras.</span>'
      text="A través de nuestro modelo de arquitectura abierta, ofrecemos una plataforma integral que brinda acceso a instrumentos financieros en múltiples monedas (más de diez divisas), utilizando la tecnología más avanzada para la gestión de las posiciones de los clientes. Trabajamos con custodios de renombre mundial para dar servicio a los activos de manera eficiente, garantizando una custodia panameña, regional y global."
    />

    <MarketStack class="mt-12 lg:mt-16" />
  </div>
</Section>
