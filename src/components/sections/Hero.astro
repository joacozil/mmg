---
import { getImage } from "astro:assets";
import HeroSection from "./HeroSection.tsx";

import heroImg from "@/assets/img/hero.jpeg";
import leftImg from "@/assets/img/torre.jpg";
import rightImg from "@/assets/img/panama.jpg";

// Optimize to WebP before handing the URLs to the React island (which renders
// plain <img>, so it can't use Astro's <Image>). Main image is wider (full
// hero), the side columns are narrower.
const hero = await getImage({ src: heroImg, format: "webp", width: 2000 });
const left = await getImage({ src: leftImg, format: "webp", width: 1200 });
const right = await getImage({ src: rightImg, format: "webp", width: 1200 });
---

<div class="relative w-full">
  <HeroSection
    client:load
    heroSrc={hero.src}
    leftSrc={left.src}
    rightSrc={right.src}
  />
</div>
