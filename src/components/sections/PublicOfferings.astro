---
import Section from "@/components/ui/Section.astro";
import FeaturesGrid from "@/components/ui/FeaturesGrid.astro";
---

<Section spacing="tight">
  <FeaturesGrid
    title="Emisiones públicas de valores"
    items={[
      {
        title: "Estructuración <br /> de emisiones de deuda",
        text: "Diseño de bonos y títulos para que las empresas obtengan financiamiento con plazos y tasas fijas.",
      },
      {
        title: "Estructuración <br /> de emisiones de capital",
        text: "Creación y diseño de acciones para captar recursos mediante nuevos inversionistas o socios.",
      },
      {
        title: "Estructuración <br /> de sociedades de inversión",
        text: "Diseño legal y operativo de fondos comunes para gestionar el capital de múltiples inversionistas.",
      },
      {
        title: "Colocación <br /> de emisiones",
        text: "Distribución y venta activa de los títulos (deuda o capital) directamente en el mercado financiero.",
      },
      {
        title: "Servicio de agente de pago, <br /> registro y transferencia",
        text: "Gestión oficial de inversionistas, control de propiedad y distribución segura de rendimientos.",
      },
      {
        title: "Servicio de agente fiduciario <br /> de garantía",
        text: "Custodia y administración neutral de activos en garantía para asegurar cumplimiento del contrato.",
      },
    ]}
  />
</Section>
