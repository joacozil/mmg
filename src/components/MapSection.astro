---
import mapSvgRaw from "../assets/img/map.svg?raw";
import WorldMap from "./WorldMap.tsx";

const title = "Soluciones globales para clientes ambiciosos.";
const text =
  "Nuestra propia sólida trayectoria nos permite operar en tres territorios clave: <strong>Panamá, Bahamas y Puerto Rico</strong>, conectándote con mercados estratégicos para que tú y tu patrimonio sigan cruzando fronteras.";
---

<WorldMap client:visible mapSvg={mapSvgRaw} title={title} text={text} />

<style is:global>
  /* ── Map wrapper ─────────────────────────────── */
  .wm .wm-wrapper {
    position: relative;
    width: 100%;
    margin-bottom: 5.5rem;
  }

  @media (min-width: 1024px) {
    .wm .wm-wrapper {
      margin-left: auto;
      margin-right: auto;
      padding-left: var(--element-padding);
      padding-right: var(--element-padding);
      max-width: 1400px;
    }
  }

  /* ── Map zoom container ──────────────────────── */
  .wm .wm-zoom {
    position: relative;
    width: 100%;
  }

  .wm .wm-inner {
    position: relative;
    width: 100%;
  }

  @media (max-width: 1023px) {
    .wm .wm-zoom {
      height: auto;
      overflow: visible;
    }
    .wm .wm-inner {
      width: 100%;
      transform: none;
    }
  }

  @media (max-width: 639px) {
    .wm .wm-zoom {
      height: auto;
      overflow: visible;
    }
    .wm .wm-inner {
      width: 100%;
      transform: none;
    }
  }

  /* Make the inlined SVG responsive + monochromatic (neutralizes the
     light/primary greens and the radial-gradient clusters in one pass). */
  .wm .wm-svg svg {
    display: block;
    width: 100%;
    height: auto;
    filter: grayscale(1);
  }

  /* Overlay sits exactly on top of the map */
  .wm .wm-overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  /* ── Expansion arcs from Panama ──────────────── */
  .wm .wm-arc {
    fill: none;
    stroke: var(--color-primary);
    opacity: 0.4;
    /* non-scaling-stroke keeps the line a true 2px regardless of how the
       SVG viewBox is scaled to the container. */
    vector-effect: non-scaling-stroke;
    stroke-width: 2px;
    stroke-linecap: round;
  }

  /* Marker squares at the end of every arc and at each hub. */
  .wm .wm-arc-dot {
    fill: var(--color-primary);
  }

  /* ── Map Labels & Lines ───────────────────────── */
  .wm [data-map-label] {
    font-size: 18px;
    font-weight: 500;
  }
  .wm [data-map-line] {
    stroke-width: 0.8px;
  }

  @media (max-width: 1023px) {
    .wm [data-map-label] {
      font-size: 16px;
    }
    .wm [data-map-line] {
      stroke-width: 1px;
    }
  }

  @media (max-width: 639px) {
    .wm [data-map-label] {
      font-size: 26px;
    }
    .wm [data-map-line] {
      stroke-width: 1.4px;
    }

    .wm .wm-wrapper {
      margin-bottom: 4.5rem;
    }
  }
</style>
